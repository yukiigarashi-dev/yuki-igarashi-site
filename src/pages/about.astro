---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About">
  <div class="space-y-12">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 tracking-tight">About</h1>
    </div>

    <section class="space-y-3">
      <h2 class="text-sm font-medium text-gray-400 uppercase tracking-widest">Summary</h2>
      <p class="text-gray-700 leading-relaxed">
        Information security and IT governance consultant.
        I work at the intersection of technology, and process.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-medium text-gray-400 uppercase tracking-widest">Professional Focus</h2>
      <ul class="space-y-1 text-gray-700">
        <li>Information security governance</li>
        <li>IT governance</li>
        <li>DX support for regulatory compliance</li>
        <li>PMO</li>
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="text-sm font-medium text-gray-400 uppercase tracking-widest">Experience</h2>
      <div class="space-y-6">
        <div class="flex gap-6">
          <span class="text-sm text-gray-400 w-24 shrink-0 pt-0.5">Current</span>
          <div>
            <p class="font-medium text-gray-900">Grant Thornton Taiyo Advisors</p>
            <p class="text-gray-500 text-sm mt-0.5">Senior Associate</p>
            <p class="text-gray-700 text-sm mt-1">Information security and IT governance consulting.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <span class="text-sm text-gray-400 w-24 shrink-0 pt-0.5">Previously</span>
          <div>
            <p class="font-medium text-gray-900">Accenture</p>
            <p class="text-gray-500 text-sm mt-0.5">Consultant</p>
            <p class="text-gray-700 text-sm mt-1">PMO for system replacement projects and DX support for regulatory compliance.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-sm font-medium text-gray-400 uppercase tracking-widest">Education</h2>
      <div class="flex gap-6">
        <span class="text-sm text-gray-400 w-24 shrink-0 pt-0.5">Waseda</span>
        <div>
          <p class="font-medium text-gray-900">Waseda University</p>
          <p class="text-gray-500 text-sm mt-0.5">Political Economy</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
