---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <div class="space-y-10">
    <section class="rounded-2xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <img
          src="/icon.jpeg"
          alt="Yuki Igarashi"
          class="h-32 w-32 rounded-2xl object-cover shadow-sm sm:h-36 sm:w-36"
        />
        <div class="space-y-3">
          <p class="inline-flex rounded-full border border-gray-300 px-3 py-1 text-xs font-medium tracking-wide text-gray-600">
            Profile
          </p>
          <div>
            <h1 class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Yuki Igarashi</h1>
            <p class="mt-2 text-sm text-gray-500 sm:text-base">
              Information Security & Governance Consultant
            </p>
          </div>
        </div>
      </div>
      <p class="mt-6 max-w-2xl leading-relaxed text-gray-700">
        I currently work on information security and IT governance consulting, drawing on prior
        experience leading PMO for system replacement projects and DX support for regulatory compliance.
      </p>
    </section>
  </div>
</BaseLayout>
