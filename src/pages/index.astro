---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <div class="space-y-6">
    <img
      src="/avatar.png"
      alt="Yuki Igarashi"
      class="w-20 h-20 rounded-full object-cover"
    />
    <div>
      <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">Yuki Igarashi</h1>
      <p class="mt-1 text-gray-500">BPR & ITGC Consultant</p>
    </div>
    <p class="text-gray-700 leading-relaxed max-w-xl">
      I work on IT governance, business process re-engineering, information security, PMO, and DX initiatives.
    </p>
  </div>
</BaseLayout>
