---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <div class="space-y-10">
    <section class="rounded-2xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <img
          src="/avatar.png"
          alt="Yuki Igarashi"
          class="h-32 w-32 rounded-2xl object-cover shadow-sm sm:h-36 sm:w-36"
        />
        <div class="space-y-3">
          <p class="inline-flex rounded-full border border-gray-300 px-3 py-1 text-xs font-medium tracking-wide text-gray-600">
            Profile
          </p>
          <div>
            <h1 class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Yuki Igarashi</h1>
            <p class="mt-2 text-sm text-gray-500 sm:text-base">
              BPR & ITGC Consultant
            </p>
          </div>
        </div>
      </div>
      <p class="mt-6 max-w-2xl leading-relaxed text-gray-700">
        I work on IT governance, business process re-engineering, information security, PMO, and DX initiatives.
      </p>
    </section>

    <section class="space-y-3">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Profile Details</h2>
        <p class="mt-1 text-sm text-gray-500">Core capabilities and focus areas.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <tbody class="divide-y divide-gray-200">
            <tr>
              <th class="bg-gray-50 px-4 py-3 font-medium text-gray-900">Location</th>
              <td class="px-4 py-3 text-gray-700">Japan</td>
            </tr>
            <tr>
              <th class="bg-gray-50 px-4 py-3 font-medium text-gray-900">Areas of Expertise</th>
              <td class="px-4 py-3 text-gray-700">MES Integration<br />IT Governance for Mid-Sized Businesses</td>
            </tr>
            <tr>
              <th class="bg-gray-50 px-4 py-3 font-medium text-gray-900">Strengths</th>
              <td class="px-4 py-3 text-gray-700">
                Bridging business operations and IT control / Practical control framework development / Support for
                mid-sized businesses
              </td>
            </tr>
            <tr>
              <th class="bg-gray-50 px-4 py-3 font-medium text-gray-900">Certification</th>
              <td class="px-4 py-3 text-gray-700">Information Security Management Certification</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
