---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogJa')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="ブログ">
  <div class="space-y-8">
    <h1 class="text-2xl font-semibold text-gray-900 tracking-tight">ブログ</h1>
    {posts.length === 0 ? (
      <p class="text-gray-400">まだ記事はありません。</p>
    ) : (
      <ul class="space-y-6">
        {posts.map(post => (
          <li>
            <a href={`/ja/blog/${post.id}`} class="group block">
              <p class="font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                {post.data.title}
              </p>
              <p class="text-sm text-gray-400 mt-0.5">
                {post.data.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              {post.data.description && (
                <p class="text-gray-600 text-sm mt-1">{post.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
